<configs>

	<append xpath="/lootcontainers">
		
		<lootgroup name="quickSolar" count="1">
			<item name="questRewardBatteryBankBundle"/>
			<item name="questRewardSolarBankBundle"/>
		</lootgroup>
		
		<lootgroup name="BloodmoonHordeRewardGroup" count="all">
			<item group="groupAirDrop01" count="1"/>
			<item group="groupAirDrop02" count="1"/>
			<item group="groupAirDrop03" count="1"/>
			<item group="groupAmmoLarge" count="1"/>
			<item group="booksAllScaled" count="1" buffs="buffPerkBookwormSuccess">
				<requirement class="RandomRoll" seed_type="Random" min_max="0,100" operation="LTE" value="@$perkBookwormChance"/>
			</item>
		</lootgroup>
		
		<lootcontainer name="BloodmoonHordeReward" size="6,6" sound_open="SupplyDrops/open_supply_crate" sound_close="SupplyDrops/close_supply_crate" open_time="0.25" loot_quality_template="qualBaseTemplate" ignore_loot_abundance="true" unmodified_lootstage="false" destroy_on_close="true">
			<item group="BloodmoonHordeRewardGroup"/>
		</lootcontainer>
		
	</append>

</configs>
