	<!-- XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX -->

	set = fijar valor
	LTE = menor o igual (Lower That Equal)
	GTE = mayor o igual (Great That Equal)
	GT  = mayor que (Great That)
	LT  = menor que (Lower That)
	Equals = igual
	NotEquals = diferente
	Add = sumar
	subtract = restar
	multiply = multiplicar
	divide = dividir
	perc_add = añadir por cada nivel de perk (precisa un requisito "ejemplo progresions miner tools")


